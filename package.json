{
  "name": "claude-usage-crab",
  "displayName": "Claude Usage Crab",
  "description": "See which Claude Code subagents are running, and spot the one that's stuck. Your agents as pixel characters in the sidebar, plus live session, weekly and context usage. Unofficial, read-only.",
  "version": "1.21.0",
  "publisher": "saegim",
  "license": "MIT",
  "icon": "marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gnldnd11/claude-usage-monitor"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude code",
    "subagent",
    "agents",
    "claude",
    "multi-agent",
    "orchestration",
    "usage",
    "tokens",
    "rate limit",
    "context window",
    "monitor",
    "status bar",
    "credits",
    "blackjack",
    "high-low",
    "poker",
    "sword forge",
    "idle game"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node test/run.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "claudeUsage.view",
          "name": "Claude Usage",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeUsage.refresh",
        "title": "Claude Usage: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeUsage.login",
        "title": "Claude Usage: Sign In (live session %)",
        "icon": "$(sign-in)"
      },
      {
        "command": "claudeUsage.openSettings",
        "title": "Claude Usage: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "claudeUsage.logout",
        "title": "Claude Usage: Sign Out",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeUsage.login",
          "when": "view == claudeUsage.view && !claudeUsage.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "claudeUsage.openSettings",
          "when": "view == claudeUsage.view",
          "group": "navigation@2"
        },
        {
          "command": "claudeUsage.logout",
          "when": "view == claudeUsage.view && claudeUsage.signedIn",
          "group": "1_z"
        }
      ]
    },
    "configuration": {
      "title": "Claude Usage",
      "properties": {
        "claudeUsage.statusBar.show": {
          "type": "string",
          "enum": [
            "session+weekly",
            "session",
            "weekly",
            "off"
          ],
          "enumDescriptions": [
            "Session (5h) and weekly (7d)",
            "Session (5h) only",
            "Weekly (7d) only",
            "Hide the status bar item"
          ],
          "default": "session+weekly",
          "markdownDescription": "What to show in the status bar item. The panel is unaffected."
        },
        "claudeUsage.panel.hidden": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "session",
              "weekly",
              "fable",
              "context",
              "ring",
              "tiles",
              "mascot",
              "credits"
            ]
          },
          "default": [],
          "markdownDescription": "Panel dashboard elements to hide. Toggle these from the panel's settings gear."
        },
      "claudeUsage.team.code": {
          "type": "string",
          "default": "",
          "markdownDescription": "Team sharing (off while empty). PCs that share one Claude account and enter the same code see each other's weekly usage side by side in Weekly > Details. Sent to the extension author's server every 10 minutes: the name below, the weekly window, the account's weekly %, and this PC's weekly usage (tokens and an API-price equivalent, per model). Never prompts, file or project names, or session titles. The code itself is stored only as a hash."
        },
      "claudeUsage.team.name": {
          "type": "string",
          "default": "",
          "maxLength": 24,
          "markdownDescription": "Your name as the rest of the team sees it. Falls back to this computer's name."
        },
        "claudeUsage.burnRate.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn on the mascot when a recent request's tokens spike vs today's average. Dismiss with the banner's × to clear until the next spike."
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/gnldnd11/claude-usage-monitor/issues"
  },
  "homepage": "https://github.com/gnldnd11/claude-usage-monitor#readme"
}
